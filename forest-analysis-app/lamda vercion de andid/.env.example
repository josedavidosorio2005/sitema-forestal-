REACT_APP_API_URL=http://10.0.2.2:5000/api
REACT_APP_STORAGE_MODE=local-first

# Para probar en un celular fisico, cambia 10.0.2.2 por la IP LAN del PC.
# Ejemplo:
# REACT_APP_API_URL=http://192.168.1.25:5000/api
#
# Modos:
# local-first = guarda en el dispositivo sin depender del backend.
# api-first = usa backend y cae a almacenamiento local si no hay conexion.

# Optional future map provider keys.
REACT_APP_MAPBOX_TOKEN=
REACT_APP_GOOGLE_MAPS_KEY=
