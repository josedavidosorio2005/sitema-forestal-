PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Use postgres for the requested production-ready stack.
# Use sqlite for a zero-setup local demo.
DB_CLIENT=postgres

# PostgreSQL
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=forest_analysis
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Optional PostGIS structure. Requires PostGIS installed in PostgreSQL.
ENABLE_POSTGIS=false

# SQLite fallback for local demos
SQLITE_FILE=./data/forest-analysis.db
AUTO_MIGRATE=true
